[Desktop Entry]
Name=Slackware Wizard
GenericName=Asistente de Configuración de Slackware
Comment=Configura idioma, teclado, usuarios, sudo, servidores web y bases de datos en Slackware
Exec=sh -c "pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY /usr/local/bin/slackwiz/slackwiz"
Icon=preferences-system
Terminal=false
Type=Application
Categories=System;Settings;
Keywords=slackware;wizard;config;setup;sudo;apache;nginx;mariadb;
