####### Compile

build/.obj/main.o: src/main.cpp src/ui/mainWindow.h \
		src/modules/timeManager.h \
		src/ui/timezoneMapWidget.h \
		src/modules/ServiceManager.h \
		src/core/logger.h \
		src/core/commandRunner.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/.obj/main.o src/main.cpp

build/.obj/logger.o: src/core/logger.cpp src/core/logger.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/.obj/logger.o src/core/logger.cpp

build/.obj/commandRunner.o: src/core/commandRunner.cpp src/core/commandRunner.h \
		src/core/logger.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/.obj/commandRunner.o src/core/commandRunner.cpp

