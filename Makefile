####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/bin/slackwiz || mkdir -p $(INSTALL_ROOT)/usr/local/bin/slackwiz
	$(QINSTALL_PROGRAM) build/$(QMAKE_TARGET) $(INSTALL_ROOT)/usr/local/bin/slackwiz/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/local/bin/slackwiz/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/bin/slackwiz/ 


install_desktop: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/share/applications || mkdir -p $(INSTALL_ROOT)/usr/local/share/applications
	$(QINSTALL) /home/augusto/projects/QT/slackwiz/resources/slackwiz.desktop $(INSTALL_ROOT)/usr/local/share/applications/slackwiz.desktop

uninstall_desktop: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/share/applications/slackwiz.desktop
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/share/applications/ 


install: install_target install_desktop  FORCE

uninstall: uninstall_target uninstall_desktop  FORCE

